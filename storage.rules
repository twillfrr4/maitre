rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function logado(){ return request.auth != null && request.auth.token.email_verified == true; }
    function email(){ return request.auth.token.email; }
    function membro(){ return logado() && (email() == 'financeiro@boscoeventos.com.br' || firestore.exists(/databases/(default)/documents/usuarios/$(email()))); }

    match /anexos/{ano}/{arquivo} {
      allow read: if membro();
      allow create: if membro() && request.resource.size < 20 * 1024 * 1024;
      allow update, delete: if false;
    }
  }
}
