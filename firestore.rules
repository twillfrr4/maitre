rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function logado(){ return request.auth != null && request.auth.token.email_verified == true; }
    function email(){ return request.auth.token.email; }
    function temPerfil(){ return exists(/databases/$(database)/documents/usuarios/$(email())); }
    function perfil(){ return get(/databases/$(database)/documents/usuarios/$(email())).data; }
    function gestao(){ return logado() && (email() == 'financeiro@boscoeventos.com.br' || (temPerfil() && perfil().perfil == 'gestao')); }
    function comercial(){ return logado() && temPerfil() && perfil().perfil == 'comercial'; }
    function membro(){ return gestao() || comercial(); }
    function cozinha(){ return logado() && temPerfil() && perfil().perfil == 'cozinha'; }
    function mise(col){ return col in ['mise_produtos','mise_etiquetas','mise_pessoas','mise_itens','mise_movimentos']; }
    function minhaPasta(pasta){ return comercial() && pasta == 'eq-' + perfil().equipeId; }

    // Fechamento do mês: lançamentos pagos (ou transferências) até o mês fechado ficam travados
    function limite(){ return exists(/databases/$(database)/documents/config/geral) ? get(/databases/$(database)/documents/config/geral).data.get('fechadoAte', '0000-00') + '-99' : '0000-00-99'; }
    function travadoPg(d){ return d.get('status', '') == 'pago' && d.get('pagoEm', '') != '' && d.get('pagoEm', '') < limite(); }
    function travadoTr(d){ return d.get('data', '') != '' && d.get('data', '') < limite(); }
    function livrePg(){ return (resource == null || !travadoPg(resource.data)) && (request.resource == null || !travadoPg(request.resource.data)); }
    // Assinatura de contrato: só a gestão marca ou altera um contrato assinado
    function assinado(d){ return d.get('assinatura', null) is map && d.assinatura.get('status', '') == 'assinado'; }
    function assinaturaOk(col){
      return gestao() || col != 'contratos' || request.resource == null
        || (!assinado(request.resource.data) && (resource == null || !assinado(resource.data)))
        || (resource != null && request.resource.data.get('assinatura', null) == resource.data.get('assinatura', null));
    }
    // Numeração (boletos/orçamentos): o comercial só avança o número, no máximo 100 por vez
    function contadorOk(){
      let n = request.resource.data;
      return request.resource != null && n.keys().hasOnly(['ano', 'n', 'em']) && n.ano is int && n.n is int && n.n >= 0
        && ((resource == null && n.n <= 100)
          || (resource != null && n.ano > resource.data.ano && n.n <= 100)
          || (resource != null && n.ano == resource.data.ano && n.n > resource.data.n && n.n <= resource.data.n + 100));
    }
    function livreTr(){ return (resource == null || !travadoTr(resource.data)) && (request.resource == null || !travadoTr(request.resource.data)); }

    match /pedidos/{e} {
      allow read: if logado() && (e == email() || gestao());
      allow create: if logado() && e == email() && request.resource.data.status == 'pendente'
        && request.resource.data.keys().hasOnly(['nome','telefone','funcao','email','status','em'])
        && request.resource.data.nome is string && request.resource.data.nome.size() <= 80
        && request.resource.data.get('telefone', '') is string && request.resource.data.get('telefone', '').size() <= 40
        && request.resource.data.get('funcao', '') is string && request.resource.data.get('funcao', '').size() <= 80
        && request.resource.data.get('email', '') is string && request.resource.data.get('email', '').size() <= 120;
      allow write: if gestao();
    }
    // Cada pessoa pode atualizar os próprios dados de contato (nunca o perfil de acesso)
    function soMeusDados(){ return request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys()
      .hasOnly(['nome','telefone','nascimento','endereco','emergNome','emergTel','foto','atualizadoEm','atualizadoPor'])
      && request.resource.data.get('foto', '') is string && request.resource.data.get('foto', '').size() < 60000; }
    match /usuarios/{e} {
      allow read: if logado() && (e == email() || gestao());
      allow write: if gestao();
      allow create, update: if logado() && e == email() && soMeusDados();
    }
    match /equipe/{id} { allow read: if membro(); allow write: if gestao(); }
    match /config/{id} { allow read: if membro(); allow write: if gestao(); }
    match /contadores/{id} { allow read: if membro(); allow write: if gestao() || (comercial() && contadorOk()); }
    match /agendaGoogle/{e} {
      allow read: if membro();
      allow write: if gestao() || (membro() && e == email() && email().matches('.*@boscoeventos[.]com[.]br'));
    }
    match /agenda/{id} {
      allow read, delete: if membro();
      allow create, update: if membro() && request.resource.data.get('titulo', '') is string && request.resource.data.get('titulo', '').size() <= 200;
    }

    match /vendas/{pasta}/{col}/{id} {
      allow read: if gestao() || minhaPasta(pasta);
      allow write: if (gestao() || minhaPasta(pasta)) && (col != 'receber' || livrePg()) && assinaturaOk(col);
    }
    // A pagar: a gestão vê tudo; o comercial lança e vê só as contas que ele criou, enquanto estiverem em aberto
    function minhaConta(d){ return d.get('criadoPor', '') == email(); }
    match /pagar/{id} {
      allow read: if gestao() || (comercial() && minhaConta(resource.data));
      allow create: if (gestao() && livrePg()) || (comercial() && minhaConta(request.resource.data) && request.resource.data.get('status', '') in ['aberto', 'cancelado']);
      allow update: if (gestao() && livrePg()) || (comercial() && minhaConta(resource.data) && resource.data.get('status', '') in ['aberto', 'cancelado']
        && minhaConta(request.resource.data) && request.resource.data.get('status', '') in ['aberto', 'cancelado']);
      allow delete: if (gestao() && livrePg()) || (comercial() && minhaConta(resource.data) && resource.data.get('status', '') in ['aberto', 'cancelado']);
    }
    match /transf/{id} { allow read: if gestao(); allow write: if gestao() && livreTr(); }

    // Lixeira e registro de alterações: todos registram, só a gestão consulta; o registro não pode ser apagado
    match /lixeira/{id} { allow create: if membro() && request.resource.data.por == email(); allow read, delete: if gestao(); }
    match /log/{id} { allow create: if membro() && request.resource.data.por == email(); allow read: if gestao(); }

    // Demais coleções (bancos, extratos, etc.): só gestão
    // Mise (estoque e etiquetas da cozinha): gestão e perfil Cozinha; a Cozinha não acessa nada do financeiro
    match /{col}/{id} {
      allow read, write: if (gestao() && !(col in ['pedidos','usuarios','equipe','config','contadores','agenda','agendaGoogle','vendas','pagar','transf','lixeira','log']))
        || (mise(col) && cozinha() && (request.resource == null || request.resource.data.size() <= 40));
    }
  }
}
